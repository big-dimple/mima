MIMA_LOGIN_PROVIDER=feishu
MIMA_DEPLOYMENT_ID=replace-with-stable-deployment-id
MIMA_REAUTH_PROVIDER=none
MIMA_E2EE_REQUIRED=true
MIMA_MIGRATION_DATABASE_ROLE=mima_migration
MIMA_DIRECTORY_PROVIDER=ldap
MIMA_PUBLIC_BASE_URL=https://mima.example.com
MIMA_WEB_ORIGINS=https://mima.example.com
MIMA_SESSION_COOKIE_SECURE=true
MIMA_TRUST_PROXY=true
MIMA_BIND_ADDRESS=127.0.0.1
MIMA_PORT=10087

MIMA_FEISHU_APP_ID=replace-me
MIMA_FEISHU_REDIRECT_URI=https://mima.example.com/api/auth/feishu/callback
MIMA_FEISHU_TENANT_KEY=replace-me

MIMA_LDAP_DIRECTORY_ID=company-ad
MIMA_LDAP_URLS=ldaps://dc01.example.com:636,ldaps://dc02.example.com:636
MIMA_LDAP_BIND_DN=CN=mima,OU=Service Accounts,DC=example,DC=com
MIMA_LDAP_BASE_DN=DC=example,DC=com
MIMA_LDAP_CA_FILE=/run/config/ldap-ca.pem
MIMA_LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
MIMA_LDAP_LOGIN_ATTRIBUTE=sAMAccountName
MIMA_LDAP_STABLE_ID_ATTRIBUTE=objectGUID
MIMA_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
MIMA_LDAP_EMAIL_ATTRIBUTE=mail
