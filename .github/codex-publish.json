{
  "schemaVersion": 1,
  "remote": "origin",
  "branch": "main",
  "runtime": {
    "nodeMajor": 24
  },
  "remoteHygiene": {
    "maxOpenBotPullRequests": 5,
    "maxUnassociatedBranches": 0,
    "inspectBotChecks": true
  },
  "gates": [
    {
      "name": "Mima public release gate",
      "argv": ["node", "scripts/github-publish-gate.mjs"]
    }
  ]
}
