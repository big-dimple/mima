{
  "name": "mima",
  "private": true,
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "可独立部署的端到端加密团队密码管理系统",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --sequential run typecheck",
    "test": "vitest run --project unit --project web --project extension",
    "test:integration": "vitest run --project integration --maxWorkers=4",
    "test:e2e": "playwright test",
    "build": "pnpm -r --sequential run build",
    "demo": "node scripts/demo.mjs up",
    "demo:down": "node scripts/demo.mjs down",
    "db:up": "bash scripts/db-up.sh",
    "db:migrate": "pnpm --filter @mima/api run db:migrate",
    "db:migrations:check": "node scripts/check-migrations.mjs",
    "public:audit": "node scripts/public-audit.mjs",
    "db:seed": "pnpm --filter @mima/api run db:seed",
    "keys:init": "node scripts/init-master-key.mjs",
    "keys:server-init": "node scripts/init-server-keys.mjs",
    "keys:rewrap": "pnpm --filter @mima/api run keys:rewrap",
    "audit:verify": "pnpm --filter @mima/api run audit:verify",
    "auth:doctor": "pnpm --filter @mima/api run auth:doctor",
    "directory:sync": "pnpm --filter @mima/api run directory:sync --",
    "system-role": "pnpm --filter @mima/api run system-role --",
    "migration:worker": "pnpm --filter @mima/api run migration:worker --",
    "migration:role:provision": "pnpm --filter @mima/api run migration:role:provision",
    "recovery:tool": "pnpm --filter @mima/recovery-tool start --",
    "api:specs:generate": "pnpm --filter @mima/api run specs:generate",
    "api:specs:check": "pnpm --filter @mima/api run specs:check",
    "extension:build:production": "MIMA_EXTENSION_PUBLIC_ VITE_MIMA_API_BASE=https://mima.example.com pnpm --filter @mima/extension run build:production",
    "runtime:scan": "pnpm --filter @mima/api build && pnpm --filter @mima/api build:migration-worker && pnpm --filter @mima/recovery-tool build && pnpm --filter @mima/web build && pnpm run extension:build:production && node scripts/verify-strict-runtime.mjs --api-dir apps/api/dist --worker-dir apps/api/dist-migration-worker --recovery-tool-file apps/recovery-tool/dist/cli.js --web-dir apps/web/dist --extension-dir apps/extension/dist --extension-api-base https://mima.example.com --openapi apps/api/openapi/openapi.json --asyncapi apps/api/openapi/asyncapi.json",
    "dev:api": "pnpm --filter @mima/api run dev",
    "dev:web": "pnpm --filter @mima/web run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.62.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.30.0",
    "jsdom": "^26.1.0",
    "pg": "^8.22.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.1"
  }
}
