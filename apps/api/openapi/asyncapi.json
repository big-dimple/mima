{
  "asyncapi": "2.6.0",
  "defaultContentType": "application/json",
  "info": {
    "title": "Mima 实时同步事件 API",
    "version": "0.2.0",
    "description": "工作台通过 SSE 接收的零知识密文事件。事件不携带可读的密码库名称、条目元数据、密码、Token 或备注正文。"
  },
  "tags": [
    {
      "name": "密文同步",
      "description": "只传递密文、版本、授权变化和同步游标。"
    }
  ],
  "servers": {
    "production": {
      "url": "mima.example.com",
      "protocol": "https",
      "description": "生产环境 SSE 入口",
      "security": [
        {
          "webSession": []
        }
      ]
    }
  },
  "channels": {
    "/api/v2/events": {
      "description": "按 cursor 回放密文事件后切换为实时投递，sync.ready 表示客户端可进入在线状态。",
      "subscribe": {
        "operationId": "streamEncryptedSyncEvents",
        "summary": "订阅密码库密文、版本和撤权变化",
        "tags": [
          {
            "name": "密文同步"
          }
        ],
        "message": {
          "$ref": "#/components/messages/EncryptedSyncEvent"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "webSession": {
        "type": "httpApiKey",
        "in": "cookie",
        "name": "mima_sid",
        "description": "HttpOnly Web 会话 Cookie。"
      }
    },
    "messages": {
      "EncryptedSyncEvent": {
        "messageId": "encryptedSyncEvent",
        "name": "EncryptedSyncEvent",
        "title": "零知识密文同步事件",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/EncryptedSyncEvent"
        }
      }
    },
    "schemas": {
      "EncryptedSyncEvent": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "item.encrypted_upserted"
              },
              "cursor": {
                "type": "integer"
              },
              "item": {
                "type": "object",
                "properties": {
                  "itemId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "vaultId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "version": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "secretVersion": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "keyEpoch": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "deleted": {
                    "type": "boolean"
                  },
                  "blob": {
                    "type": "object",
                    "properties": {
                      "suite": {
                        "type": "string",
                        "const": "lm-e2ee-v1"
                      },
                      "aadVersion": {
                        "type": "number",
                        "const": 1
                      },
                      "nonce": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200000,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "ciphertext": {
                        "$ref": "#/components/schemas/EncryptedSyncEvent/anyOf/0/properties/item/properties/blob/properties/nonce"
                      }
                    },
                    "required": [
                      "suite",
                      "aadVersion",
                      "nonce",
                      "ciphertext"
                    ],
                    "additionalProperties": false
                  },
                  "createdAt": {
                    "type": "string"
                  },
                  "updatedAt": {
                    "type": "string"
                  },
                  "updatedBy": {
                    "type": "string"
                  }
                },
                "required": [
                  "itemId",
                  "vaultId",
                  "version",
                  "secretVersion",
                  "keyEpoch",
                  "deleted",
                  "blob",
                  "createdAt",
                  "updatedAt",
                  "updatedBy"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "cursor",
              "item"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "item.deleted"
              },
              "cursor": {
                "type": "integer"
              },
              "vaultId": {
                "type": "string",
                "format": "uuid"
              },
              "itemId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "cursor",
              "vaultId",
              "itemId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "vault.crypto_changed"
              },
              "cursor": {
                "type": "integer"
              },
              "state": {
                "type": "object",
                "properties": {
                  "vaultId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "legacy",
                      "preparing",
                      "frozen",
                      "encrypting",
                      "verifying",
                      "e2ee",
                      "rekey_required"
                    ]
                  },
                  "activeEpoch": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "accessGeneration": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pendingEpoch": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rekeyTaskId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "encryptedHeader": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/EncryptedSyncEvent/anyOf/0/properties/item/properties/blob"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "migrationJobId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "recoveryRequired": {
                    "type": "boolean"
                  },
                  "recoveryReason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "missing_current_full_envelope"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "updatedAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "vaultId",
                  "status",
                  "activeEpoch",
                  "pendingEpoch",
                  "rekeyTaskId",
                  "encryptedHeader",
                  "migrationJobId",
                  "updatedAt"
                ],
                "additionalProperties": false
              },
              "header": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "vaultId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "version": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "keyEpoch": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "blob": {
                        "$ref": "#/components/schemas/EncryptedSyncEvent/anyOf/0/properties/item/properties/blob"
                      },
                      "updatedAt": {
                        "type": "string"
                      },
                      "updatedBy": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "vaultId",
                      "version",
                      "keyEpoch",
                      "blob",
                      "updatedAt",
                      "updatedBy"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "cursor",
              "state",
              "header"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "vault.rekey_required"
              },
              "cursor": {
                "type": "integer"
              },
              "vaultId": {
                "type": "string",
                "format": "uuid"
              },
              "pendingEpoch": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "taskId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "cursor",
              "vaultId",
              "pendingEpoch",
              "taskId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "vault.revoked"
              },
              "cursor": {
                "type": "integer"
              },
              "vaultId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "cursor",
              "vaultId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "crypto.profile_rewrapped"
              },
              "cursor": {
                "type": "integer"
              },
              "actorDeviceId": {
                "type": "string",
                "format": "uuid"
              },
              "profileVersion": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "type",
              "cursor",
              "actorDeviceId",
              "profileVersion"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "device.revoked"
              },
              "cursor": {
                "type": "integer"
              },
              "deviceId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "type",
              "cursor",
              "deviceId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "sync.cursor"
              },
              "cursor": {
                "type": "integer"
              }
            },
            "required": [
              "type",
              "cursor"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "sync.ready"
              },
              "cursor": {
                "type": "integer"
              },
              "vaultIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "required": [
              "type",
              "cursor",
              "vaultIds"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
