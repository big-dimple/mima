{
  "name": "@mima/extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:production": "MIMA_EXTENSION_PRODUCTION_BUILD=true pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --project extension apps/extension/test"
  },
  "dependencies": {
    "@mima/contracts": "workspace:*",
    "@mima/domain": "workspace:*",
    "@mima/e2ee": "workspace:*",
    "@mima/ui-tokens": "workspace:*",
    "lucide": "^0.525.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
